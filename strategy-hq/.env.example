# GameScout HQ / GTA VI Strategy HQ — environment variables
# Copy to .env.local (local) or set in your host's encrypted settings (production).
# NEVER commit real values. Everything optional is OFF when unset.

# --- Required ---------------------------------------------------------------
# Postgres connection (Supabase: Project Settings → Database → connection string, "session" mode).
DATABASE_URL=postgres://gsq_owner:CHANGE_ME@127.0.0.1:5432/gsq
# Public URL of the deployed app (used in email deep links).
APP_BASE_URL=http://localhost:3100
# founder_private (default) | closed_beta | commercial. Controls rights gating and who may be emailed.
APP_MODE=founder_private
# Long random string. The scheduler must send "Authorization: Bearer <CRON_SECRET>" to /api/cron/tick.
CRON_SECRET=

# --- Schedule (America/New_York wall-clock; DST handled in code) -------------
BRIEF_TIMEZONE=America/New_York
SCAN_LOCAL_TIME=07:15
BRIEF_LOCAL_TIME=08:30

# --- Morning email (Resend). Sends ONLY if REPORT_ENABLED=true AND the admin flag
# `email_delivery` is on AND the user opted in AND (founder mode) recipient == REPORT_TO_EMAIL.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=
REPORT_ENABLED=false

# --- Optional AI coach (Anthropic). Local search works without it. ----------
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. Cheaper option: claude-haiku-5-5.
ASSISTANT_MODEL=claude-opus-5-5
# Hard platform-wide daily ceiling in USD. Calls stop for the day when reached.
LLM_DAILY_BUDGET_USD=1

# --- Reddit Data API (approved app only; commercial use needs a Reddit agreement)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Billing (staging only; live billing is locked off in the database) ------
BILLING_PROVIDER=none
BILLING_WEBHOOK_SECRET=

# --- Private uploads (screenshots, imported maps) ---------------------------
UPLOAD_DIR=.data/uploads

# --- One-time founder account creation (npm run founder:create) -------------
# FOUNDER_EMAIL=
# FOUNDER_PASSWORD=   # 12+ characters; hashed with scrypt, never stored in plain text
# FOUNDER_NAME=
